          }
        }
      }
    },
    "Flag --idle-release: unwires and frees VRAM model weights when idle, restoring them on-the-fly when new queries arrive." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parámetro --idle-release: desvincula y libera los pesos en VRAM cuando no hay peticiones activas, restaurándolos al vuelo al recibir nuevas consultas."
          }
        }
      }
    },
    "Flag --max-memory: limits the Metal unified memory budget to avoid exhausting Mac RAM." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
